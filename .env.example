# All keys are OPTIONAL and FREE (no credit card). The app runs without any of them.
# Twelve Data free key → spot XAU/USD candles (otherwise the chart uses COMEX futures GC=F): https://twelvedata.com/pricing
TWELVEDATA_API_KEY=
# FRED free key → CPI (seasonally adjusted) + official data-release dates fallback: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Finnhub free key → extra market headlines: https://finnhub.io/register
FINNHUB_API_KEY=

# Server
PORT=8787
# Use 0.0.0.0 to expose on your LAN / inside Docker
HOST=127.0.0.1
# DB_PATH=./data/gold.db
