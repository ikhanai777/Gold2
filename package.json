{
  "name": "gold-signal-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Gold Signal Dashboard: live XAU/USD, factors, news, S/R chart, range projections and a scored buy/sell board. Free data sources only.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts && tsc -p server/tsconfig.json --noEmit",
    "start": "tsx server/src/index.ts",
    "test": "node --import tsx --test server/test/*.test.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "check:integrity": "node scripts/check-integrity.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "tsx": "^4.23.15",
    "undici": "^7.30.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "lightweight-charts": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
